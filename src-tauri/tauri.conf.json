{
  "$schema": "../ui/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mixmap",
  "identifier": "app.mixmap.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mixmap",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#121417",
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "title": "mixmap overlay",
        "url": "overlay.html",
        "width": 760,
        "height": 340,
        "minWidth": 320,
        "minHeight": 160,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://artwork.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "mixmap",
    "shortDescription": "Transition graph and live overlay for rekordbox",
    "category": "Music"
  }
}
